# swa-demo CP bridge configuration — installed to /etc/swa-cp/cp-bridge.env.
# The bridge holds the CP object coordinates so no Safe/Object names travel from
# the cluster; the pod only names a scenario.

# Listen address reachable from the minikube pod (host.minikube.internal).
CP_BRIDGE_ADDR=0.0.0.0:8890

# The CP Application id provisioned in CyberArk.
CP_APP_ID=SWA-CP-Demo

# Scenario 1 (authorized) + used by scenario 2 (invalid-hash) too.
CP_SAFE=SWA-CP-Demo-Safe
CP_OBJECT=db-credential
CP_FOLDER=Root

# Scenario 3 (denied): a Safe the App is NOT permitted to read.
CP_DENIED_SAFE=Restricted-Safe
CP_DENIED_OBJECT=privileged-credential

# Scenario 4 (dual account): an exact query resolving to the ACTIVE account.
CP_DUAL_QUERY=Safe=SWA-CP-Demo-Safe;Folder=Root;Object=svc-app-db
CP_DUAL_VIRTUAL=svc-app-db

# SDK + caller locations (defaults shown).
CP_SDK_JAR=/opt/CARKaim/sdk/JavaPasswordSDK.jar
# CP_SDK_LIBDIR defaults to the directory of CP_SDK_JAR (holds libjavapasswordsdk.so).
# CP_SDK_LIBDIR=/opt/CARKaim/sdk
CP_CALLER_JAR=/opt/swa-cp/cp-caller.jar
CP_ROGUE_JAR=/opt/swa-cp/rogue/cp-caller.jar
# JAVA_BIN=java
