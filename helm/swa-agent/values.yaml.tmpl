# Values for the SWA Agent chart (helm/charts/swa-agent-0.1.0.tgz).
# Rendered by scripts/deploy-swa.sh. Keys match the chart's values.yaml exactly.

# Image is pre-loaded into minikube from the S3 .tar (repo:tag auto-detected).
image:
  repository: "${SWA_AGENT_IMAGE_REPO}"
  tag: "${SWA_AGENT_IMAGE_TAG}"
  pullPolicy: Never

# Must match the control plane trust domain (terraform-swa trust_domain_name).
trustDomain:
  name: "${SWA_TRUST_DOMAIN}"

# Insecure bootstrap: the agent sources the server's trust bundle over the
# initial connection instead of a pre-shared bundle. Appropriate for this
# in-cluster demo (agent + server co-located). Without this (and with no
# bootstrap.bundleSourceUrl) the agent crashes: "could not correctly source the
# agent bootstrap bundle". For production, publish a bundle and set
# bootstrap.bundleSourceUrl instead.
bootstrap:
  insecure: true

# Reach the in-cluster SWA Server Service.
server:
  address: "swa-server.${NS_SWA}.svc.cluster.local:8443"

agent:
  healthAddr: "0.0.0.0:8082"
  # Workload API socket the demo webapp connects to (inside the pod path).
  socketPath: /tmp/swa-agent/public/api.sock

nodeAttestor:
  type: k8s_psat
  k8s_psat:
    # Must match the server_group cluster key in terraform-swa.
    cluster: "${SWA_CLUSTER_NAME}"
    audience: "swa-server"
    tokenPath: /var/run/secrets/swa/serviceaccount/token

workloadAttestors:
  - type: k8s
    config:
      # minikube's kubelet (https://<node>:10250) serves a self-signed cert, so
      # the k8s workload attestor's TLS verification fails with "certificate
      # signed by unknown authority". Skip kubelet cert verification for this
      # demo. For production, set kubeletCAPath to the cluster CA instead.
      skipKubeletVerification: true
      nodeNameEnv: MY_NODE_NAME

serviceAccount:
  create: true
  name: "swa-agent"

rbac:
  create: true

# Host path exposing the Workload API socket to pods on the same node.
socketHostPath: /tmp/swa-agent

# Node group label consumed by the server's agent SPIFFE ID template (k8s_psat).
podLabels:
  swa_nodegroup: "${SWA_NODE_GROUP}"

# ACCEPTED RISK — both host namespaces are REQUIRED by the SWA agent on the
# minikube Docker driver. We TESTED dropping them on SWA v1.0.3 (2026-07-23) and
# both are still needed; do NOT set either to false here.
#   - hostNetwork: the k8s WORKLOAD attestor must reach the node kubelet
#     (https://<node>:10250) to map a caller to its pod. From the pod network
#     (hostNetwork:false + dnsPolicy:ClusterFirst) it cannot, so the agent resets
#     every Workload API connection ("connection reset by peer" at the socket) and
#     workloads never get SVIDs. NOTE: NODE attestation (k8s_psat -> server) keeps
#     working, so the agent still mints its OWN node SVID — which masks the outage.
#   - hostPID: caller-PID -> pod resolution on the Docker driver (the agent reads
#     the peer PID via SO_PEERCRED and must see it in the host PID namespace).
# Mitigations: agent runs non-root (runAsUser 65532), non-privileged,
# allowPrivilegeEscalation=false (securityContext below). Inherent to a SPIFFE
# node agent; accepted (.trivyignore AVD-KSV-0009 hostNetwork / AVD-KSV-0010 hostPID).
hostPID: true
hostNetwork: true
setNodeNameEnv: true
dnsPolicy: ClusterFirstWithHostNet

securityContext:
  runAsUser: 65532
  runAsGroup: 65532
  privileged: false
  allowPrivilegeEscalation: false

telemetry:
  logging:
    level: info

resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    cpu: 200m
    memory: 128Mi
